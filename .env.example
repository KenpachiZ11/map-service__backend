# =============================================================================
# map-service-backend — пример переменных окружения
# Скопируйте этот файл в .env и при необходимости измените значения.
# .env не попадает в git — обновляйте этот файл при добавлении новых переменных.
# =============================================================================

# Окружение приложения: development | production | test
NODE_ENV=development

# HTTP-порт, на котором слушает API
PORT=3000

# Название сервиса (используется в информационном endpoint и Swagger)
APP_NAME=map-service-backend

# Разрешённые CORS-ориджины (через запятую). Здесь удобно указать origin frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# PostgreSQL (TypeORM) — конфигурация в src/config/typeorm.config.ts
# Подключение TypeOrmModule будет добавлено отдельно.
# =============================================================================
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=map_service
# DB_SYNCHRONIZE=true автоматически синхронизирует схему с сущностями.
# ВАЖНО: для продакшена должно быть false (и использовать миграции).
DB_SYNCHRONIZE=false
# Логировать SQL-запросы TypeORM.
DB_LOGGING=false

# =============================================================================
# JWT-авторизация (модуль src/auth)
# =============================================================================
# Секрет для подписи JWT. ВАЖНО: для продакшена задать свой надёжный секрет.
JWT_SECRET=dev-secret-change-me-in-prod
# Срок жизни токена (например 15m, 1h, 1d, 7d).
JWT_EXPIRES_IN=1d